# Generated by picomos — do not edit.
# Generic MOS cross file for building picolibc's shared libraries.
# No machine-specific fields; machines apply their linker script + crt0
# at final link time.

[binaries]
c   = ['@PICOMOS_MOS_CLANG@', '-nostdlib', '-flto',
       '-D__COMPILING_MOS_LIBC__', '-D__IEEE_LITTLE_ENDIAN', '-D_LDBL_EQ_DBL',
       '-Oz', '-g', '-Wno-tautological-compare']
ar  = 'llvm-ar'
as  = '@PICOMOS_MOS_CLANG@'

[host_machine]
system     = 'unknown'
cpu_family = 'mos'
cpu        = 'mos'
endian     = 'little'

[properties]
skip_sanity_check = true
libgcc             = ['-L@PICOMOS_LIBRT_DIR@', '-lclang_rt.builtins']
ram_only           = true
