# Generated by picomos — do not edit.
# Generic MOS cross file for building picolibc's shared libraries.
# No machine-specific fields; machines apply their linker script + crt0
# at final link time.

[binaries]
c   = ['@PICOMOS_MOS_CLANG@', '-nostdlib', '-flto',
       '-D__COMPILING_MOS_LIBC__', '-D__IEEE_LITTLE_ENDIAN', '-D_LDBL_EQ_DBL',
       '-Oz', '-g', '-Wno-tautological-compare']
ar  = '@PICOMOS_MOS_AR@'
as  = '@PICOMOS_MOS_CLANG@'

[host_machine]
system     = 'unknown'
cpu_family = 'mos'
cpu        = 'mos'
endian     = 'little'

[properties]
skip_sanity_check = true
libgcc             = ['-L@PICOMOS_LIBRT_DIR@', '-lclang_rt.builtins']
ram_only           = true

# picomos supplies the MEMORY {} block from each machine's own linker
# script at final link time. See upstream picolibc PR-2.
external_memory    = true

# Bake the llvm-mos imaginary register (__rc0..__rc31) definitions and
# the .vectors section into picolibc's generated linker script. These
# are architecture-level: every MOS machine uses the same zero-page
# slots and the same reset/nmi/irq vector layout at 0xFFFA-0xFFFF.
# picolibc's meson INCLUDE resolver reads these relative to picolibc's
# source root. The MEMORY {} that hosts these (including the `vectors`
# region) comes from each machine's link.ld at final link time.
linker_preamble    = 'INCLUDE picocrt/machine/mos/mos-regs.ld'
extra_sections     = 'INCLUDE picocrt/machine/mos/mos-sections.ld'
